{
  "name": "e2e",
  "type": "module",
  "devDependencies": {
    "@types/gifencoder": "^2.0.3",
    "@types/jasmine": "^5.1.5",
    "@types/jsdom": "^30.0.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/jasmine-framework": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.13.3",
    "nyc": "^18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "wdio": "wdio run ./config/wdio.conf.ts",
    "coverage-report": "nyc report --reporter=lcovonly --report-dir=coverage/e2e --cwd=../",
    "list_parallel": "cd scripts && node --import=tsx ./list_parallel.js",
    "tests_to_filename": "node ./scripts/tests_to_filename.js",
    "demo": "wdio run ./config/wdio.conf.ts --trailence-username=demo@trailence.org --trailence-password=thisisdemo --browser=chrome --demo",
    "deploy_demo": "cd scripts/deploy_demo && npm run deploy_demo --ssversion=$npm_config_ssversion",
    "appium": "appium driver doctor uiautomator2"
  },
  "dependencies": {
    "jsdom": "^30.1.1",
    "puppeteer-core": "^24.43.1"
  }
}
