{
  "name": "trailence",
  "version": "2.3.0",
  "author": "Guillaume Le Cousin",
  "homepage": "https://www.trailence.org/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-ci": "ng test --configuration=ci --watch=false --no-watch",
    "lint": "ng lint",
    "install-global-commands": "npm install -g cpy-cli@7.0.0 rimraf@6.1.3 mkdirp@3.0.1",
    "update-android": "ionic capacitor update android",
    "install-android": "ionic capacitor sync android --configuration=android-%npm_config_env% && rimraf android/app/src/main/assets/public/assets/apk && rimraf android/app/src/main/assets/public/media && rimraf android/app/src/main/assets/public/assets/admin && rimraf android/app/src/main/assets/public/assets/apk-install && cd android/environments/%npm_config_env% && cpy . ../..",
    "install-android-dev": "npm run install-android --env=dev",
    "install-android-local": "npm run install-android --env=local",
    "install-android-prod": "npm run install-android --env=prod",
    "install-android-playstore": "npm run install-android --env=playstore",
    "install-android-appgallery": "npm run install-android --env=appgallery",
    "install-android-fdroid": "npm run install-android --env=fdroid",
    "set-version": "node ./scripts/set-version.js %npm_config_newversion%",
    "check-i18n": "node --import=tsx ./scripts/check-i18n.ts",
    "check-assets-version": "node ./scripts/check-assets-version.js",
    "check-release-note": "node --import=tsx ./scripts/check-release-note.ts %npm_config_newversion%",
    "notes-to-fastlane": "node --import=tsx ./scripts/notes-to-fastlane.ts %npm_config_newversion%",
    "release": "npm run check-i18n && npm run check-assets-version && npm run check-release-note && npm run set-version && ng build --configuration=production",
    "instrument": "nyc instrument www/browser www/browser --exclude-after-remap=false --complete-copy --in-place --exclude=**/polyfills*.js --exclude=**/scripts*.js --exclude=**/swipe-back*.js --exclude=**/shadow-css*.js --exclude=**/jszip*.js --exclude=**/ios.transition*.js --exclude=**/md.transition*.js --exclude=**/input-shims*.js --exclude=**/hardward-back-button*.js --exclude=**/focus-visible*.js --exclude=**/keyboard2*.js --exclude=**/status-tap*.js --exclude=**/*.mjs --exclude=**/assets/*.js",
    "analyze-bundle": "ng build --configuration=analyze-bundle --progress=false --stats-json > build.output && node ./scripts/extract-initial-bundle.js ./build.output",
    "generate-public-pages": "cd scripts && node --import=tsx generate-public-pages.ts && cd ..",
    "generate-local-nginx": "cd docker/local && node --import=tsx generate-local-nginx.ts && cd ../..",
    "make-leaflet-esm": "node ./scripts/make-leaflet-esm.js",
    "postinstall": "node ./scripts/make-leaflet-esm.js && cd ./node_modules/blob-stream && (cpy .js . --rename=blob-stream.js || cp .js blob-stream.js) && cd ../svg-to-pdfkit && (cpy source.js . --rename=svg-to-pdfkit.js || cp source.js svg-to-pdfkit.js)",
    "build-assets": "node --import=tsx src/icons/mapping/build.ts",
    "build-doc": "cd doc && node build/build.js",
    "circle": "dpdm ./src/main.ts --ext .ts,.d.ts,.tsx,.mjs,.js,.jsx,.json --tsconfig ./tsconfig.json --tree false --ignore-skip-warning node_modules ./"
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/service-worker": "^22.1.5",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.0",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@ionic/angular": "^9.0.0",
    "angular-code-input": "^2.0.0",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.5",
    "immutable": "^5.1.5",
    "ionicons": "^8.0.13",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "ng2-charts": "^10.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.7.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.2.0",
    "@angular-eslint/eslint-plugin": "^22.2.0",
    "@angular-eslint/eslint-plugin-template": "^22.2.0",
    "@angular-eslint/schematics": "^22.2.0",
    "@angular-eslint/template-parser": "^22.2.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/language-service": "^22.1.5",
    "@capacitor/cli": "^8.5.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "@types/jasmine": "^5.1.13",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "blob-stream": "^0.1.3",
    "dpdm": "^4.3.0",
    "eslint": "^9.39.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "jasmine-spec-reporter": "^7.0.0",
    "jsdom": "^26.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "nyc": "^18.0.0",
    "pdfjs-dist": "^5.4.449",
    "pdfkit": "^0.17.2",
    "svg-to-pdfkit": "^0.1.8",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "description": "Trailence"
}
